# Bootstrap codegen: turn a server module plus its manifest into a script
# with a static dispatcher.
#
# Nushell parses statically, so a command named in a runtime string cannot
# be called directly. The generated script instead contains one `match` arm
# per annotated command, each unpacking the validated argument record into
# that command's positional parameters, flags and rest parameter.

def arg-expr [p: record]: nothing -> string {
  let access = '$args.' + ($p.name | to nuon) + '?'
  match $p.kind {
    'positional' => { '(' + $access + ')' }
    'rest' => { '...(' + $access + ' | default [])' }
    'named' => { '--' + $p.name + '=(' + $access + ')' }
    'switch' => { '--' + $p.name + '=(' + $access + ' | default false)' }
  }
}

# The Nushell call for one command, reading arguments from `$args`.
export def call-expr [command: string, params: list]: nothing -> string {
  [$command ...($params | each {|p| arg-expr $p })] | str join ' '
}

# Raw strings must not start with `#`: `r#'#` lexes as an empty string.
const TEMPLATE = r#'
# Generated by fastmcp from {{SOURCE}}
# Do not edit: regenerate with `fastmcp-nu build`.
use fastmcp
use {{SOURCE_NUON}} *

const FASTMCP_MANIFEST = {{MANIFEST}}

def __fastmcp_invoke [command: string, args: record]: nothing -> any {
  match $command {
{{ARMS}}
    _ => { error make {msg: $"fastmcp-nu: no dispatcher for command '($command)'"} }
  }
}

{{ENTRY}}
'#

const STDIO_ENTRY = r#'def main []: any -> nothing {
  fastmcp serve stdio ($FASTMCP_MANIFEST | fastmcp server {|command, args| __fastmcp_invoke $command $args })
}'#

const HTTP_ENTRY = r#'
# http-nu serves the closure this script evaluates to.
let server = ($FASTMCP_MANIFEST | fastmcp server {|command, args| __fastmcp_invoke $command $args })
fastmcp serve http $server --path {{PATH}} --allow-origin {{ORIGINS}}'#

# Generate the server script for a module and its manifest.
export def codegen [
  source: path                       # The server module (absolute path)
  manifest: record                   # Its manifest, from `fastmcp discover`
  --transport: string = 'stdio'      # stdio or http
  --path: string = '/mcp'            # http: endpoint path
  --allow-origin: list<string> = []  # http: extra allowed Origin values
]: nothing -> string {
  let entries = [...$manifest.tools ...$manifest.resources ...$manifest.templates ...$manifest.prompts]
  let commands = ($entries | each {|e| {command: $e.command, params: $e.params} } | uniq-by command)
  let arms = (
    $commands
    | each {|c| $"    ($c.command | to nuon) => { (call-expr $c.command $c.params) }" }
    | str join "\n"
  )
  let entry = match $transport {
    'stdio' => { $STDIO_ENTRY }
    'http' => {
      $HTTP_ENTRY
      | str replace '{{PATH}}' ($path | to nuon)
      | str replace '{{ORIGINS}}' ($allow_origin | to nuon)
    }
    _ => { error make {msg: $"unknown transport '($transport)', expected stdio or http"} }
  }
  $TEMPLATE
  | str trim --left
  | str replace --all '{{SOURCE}}' $source
  | str replace '{{SOURCE_NUON}}' ($source | to nuon)
  | str replace '{{MANIFEST}}' ($manifest | to nuon --indent 2)
  | str replace '{{ARMS}}' $arms
  | str replace '{{ENTRY}}' $entry
}
